<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nestworth"
        Arguments=""
        InstallLocation="C:\Program Files\Nestworth\Nestworth">
    </Installer>
    <PackageInformation
        PackageName="Nestworth"
        PackageDisplayName="Nestworth"
        PublisherName="CN=Nestworth"
        PublisherDisplayName="Nestworth"
        Version="0.3.2.0"
        PackageDescription="A local-first personal finance desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="Nestworth"
                Description="A local-first personal finance desktop application"
                DisplayName="Nestworth"
                ExecutableName="nestworth"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Nestworth</DisplayName>
            <PublisherDisplayName>Nestworth</PublisherDisplayName>
            <Description>A local-first personal finance desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nestworth.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
