# Refuse to install package versions published less than 7 days (10080 minutes)
# ago, reducing exposure to freshly compromised or malicious releases.
# Honoured by pnpm and bun; npm currently has no native support and ignores it,
# so this is harmless today and forward-compatible.
minimum-release-age=10080
# Wails v3 is pinned at 3.0.0-beta.19 (see docs/development/engineering-guide.md).
# That exact runtime version is the only age-gate exception: the 7-day wait
# would block CI until the beta is old enough, and downgrading Wails is
# outside this change. All other packages still wait 7 days.
minimum-release-age-exclude[]=@wailsio/runtime@3.0.0-beta.19
