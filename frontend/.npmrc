# Refuse to install package versions published less than 7 days (10080 minutes)
# ago, reducing exposure to freshly compromised or malicious releases.
# Honoured by pnpm and bun; npm currently has no native support and ignores it,
# so this is harmless today and forward-compatible.
#
# pnpm 11+ also reads these from frontend/pnpm-workspace.yaml (canonical).
# Keep both in sync: CI on pnpm 12.2.1 ignored the .npmrc exclude array.
minimum-release-age=10080
# Keep the reviewed exceptions aligned with pnpm-workspace.yaml.
minimum-release-age-exclude[]=@wailsio/runtime@3.1.0
# GHSA-p4f5-76q4-ffq7 requires the patched Vite and Rolldown releases.
minimum-release-age-exclude[]=vite@8.3.7
minimum-release-age-exclude[]=rolldown@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-android-arm-eabi@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-android-arm64@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-darwin-arm64@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-darwin-x64@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-freebsd-x64@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-arm-gnueabihf@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-arm64-gnu@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-arm64-musl@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-ppc64-gnu@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-s390x-gnu@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-x64-gnu@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-linux-x64-musl@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-openharmony-arm64@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-win32-arm64-msvc@1.2.18
minimum-release-age-exclude[]=@rolldown/binding-win32-x64-msvc@1.2.18
